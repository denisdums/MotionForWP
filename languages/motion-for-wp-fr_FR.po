#: src/Admin/Settings_Page.php:370
msgid ""
"Set the default parameters used when a block does not define its own values."
msgstr ""
"Définissez les paramètres utilisés par défaut lorsqu’un bloc ne possède pas "
"ses propres valeurs."

#: src/Admin/Settings_Page.php:371
msgid "Value priority:"
msgstr "Priorité des valeurs :"

#: src/Admin/Settings_Page.php:371
msgid "Settings defined directly on a block override these global defaults."
msgstr "Les réglages définis directement sur un bloc remplacent ces valeurs globales par défaut."

#: src/Admin/Settings_Page.php:378
